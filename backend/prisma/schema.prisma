generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Change to "postgresql" or "mysql" if needed
  url      = "file:./dev.db"
}

enum Role {
  CUSTOMER
  ADMIN
  SELLER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  phone       String?   @unique
  gender      String? // Optional: "Male", "Female", "Other"
  dateOfBirth DateTime?
  role        Role      @default(CUSTOMER)
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  Product   Product[]

  @@map("users")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  line1     String
  line2     String?
  city      String
  state     String
  country   String
  zipCode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  reviews    Review[]
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(PENDING)
  total     Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orderItems OrderItem[]
}

model OrderItem {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    String
  rating    Int // e.g. 1 to 5
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}



// Prisma Schema Syntax Basics
// model ModelName { ... } — Defines a table/entity in your database.

// fieldName Type — Defines a column/field.

// @id — Marks this field as the primary key.

// @default(value) — Sets a default value.

// @unique — Marks the field unique.

// @relation(fields: [...], references: [...]) — Defines a foreign key relationship.

// enum EnumName { ... } — Defines an enumeration.

// @map("db_table_name") — Maps model/table or field names to actual database names.

// Scalar types: String, Int, Float, Boolean, DateTime.

// Models Explained
// 1. User
// prisma
// Copy
// Edit
// model User {
//   id          String    @id @default(uuid())
//   name        String
//   email       String    @unique
//   password    String
//   phone       String?   @unique
//   gender      String?   // Optional: "Male", "Female", "Other"
//   dateOfBirth DateTime?
//   role        Role      @default(CUSTOMER)
//   isVerified  Boolean   @default(false)
//   createdAt   DateTime  @default(now())
//   updatedAt   DateTime  @updatedAt

//   addresses   Address[]
//   orders      Order[]
//   reviews     Review[]

//   @@map("users")
// }
// id: Primary key, UUID string automatically generated.

// name, email, password: Basic user info.

// email: Unique, no duplicates allowed.

// phone: Optional unique phone number.

// gender, dateOfBirth: Optional fields.

// role: Enum Role (CUSTOMER, ADMIN, SELLER), default CUSTOMER.

// isVerified: Whether user verified email.

// createdAt: Timestamp when created, defaults to now.

// updatedAt: Timestamp auto-updated on record update.

// Relations:

// addresses: One user has many addresses.

// orders: One user has many orders.

// reviews: One user writes many reviews.

// @@map("users"): Maps model name User to database table users.

